<?xml version="1.0" encoding="utf-8"?>
<!-- deckd is a plain-HTTP service on Jon's own Pi. Cleartext is allowed
     ONLY to the Pi's two addresses (tailnet + home LAN). Everything else
     keeps the platform default (no cleartext). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">100.68.172.113</domain>
        <domain includeSubdomains="false">192.168.4.23</domain>
    </domain-config>
</network-security-config>
